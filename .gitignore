## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Build files
*.[Cc]ache
*.csproj.user
*.orig

# Docker
.dockerignore

# Node.js
node_modules/
npm-debug.log
yarn-error.log
.pnpm-debug.log
.yarn/
.yarn-integrity
*.tsbuildinfo

# Frontend
*.env.local
*.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
out/
.turbo/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local history
.local-history/

# Database
*.db
*.sqlite
*.mdf
*.ldf

# OS
.DS_Store
Thumbs.db

# Secrets
appsettings.Development.json
appsettings.Production.json
secrets.json
*.pem
*.key